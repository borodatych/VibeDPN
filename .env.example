# VibeDPN — .env. Пишет `vibedpn init` (Stage 1) из config.yaml; в git не попадает.
#
# Профили Compose — производная от роли и включённых секций config.yaml (docs/roles.md).
# Роль home с provider, dpn, dns и ui:
COMPOSE_PROFILES=provider,consumer,router,dns,ui

# Тег образов ghcr.io/vibebrainsprojects/vibedpn-{core,wg,ui}. `vibedpn update` двигает его.
VIBEDPN_TAG=latest
