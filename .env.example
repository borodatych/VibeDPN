# VibeDPN — .env. Пишет `vibedpn init` (Stage 1); в git не попадает.
# Всё, кроме VIBEDPN_TAG, — производные от config.yaml: править надо config.yaml, потом `vibedpn restart`.

# Профили Compose по роли и включённым секциям (docs/roles.md). Роль home с provider, dpn, dns и ui:
COMPOSE_PROFILES=provider,consumer,router,dns,ui
# Порт API ядра (api.port): healthcheck и прокси из ui
VIBEDPN_API_PORT=4480
# Адрес коробки в LAN (network.lan_address): на нём слушают ui и dns
VIBEDPN_LAN_IP=192.168.1.50
# Порт веб-интерфейса (ui.port)
VIBEDPN_UI_PORT=80
# Имя панели (ui.host_name): AdGuard отвечает на него адресом коробки, панель пускает с него вход
VIBEDPN_UI_HOST_NAME=vibedpn.lan
# UDP-диапазон ноды (provider.udp_ports) и порядок обхода NAT (provider.traversal)
VIBEDPN_MYST_UDP_FROM=56000
VIBEDPN_MYST_UDP_TO=56100
VIBEDPN_MYST_TRAVERSAL=manual,upnp,holepunching

# Тег образов ghcr.io/borodatych/vibedpn-{core,wg,ui}; `vibedpn update` двигает его.
# `init` выводит его из ветки чекаута (main → latest, иначе имя ветки), потом не меняет.
VIBEDPN_TAG=latest
# Пины сторонних образов (MYST_TAG, ADGUARD_TAG) живут в compose.yaml; переопределять здесь — только осознанно.
