// VibeDPN: security updates of the OS, applied unattended. Dropped in by install.sh next to
// Debian's own 50unattended-upgrades, which keeps the list of origins; this file only turns
// the timers on and states what the box must never do on its own.
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";

// The box is a router: a reboot of its own accord takes the household's network down with it.
Unattended-Upgrade::Automatic-Reboot "false";
// Left behind by an interrupted upgrade, a half-configured package blocks every later one.
Unattended-Upgrade::AutoFixInterruptedDpkg "true";
// Nothing leaves the box: no mail, no reports to anyone (rule "no telemetry our way").
Unattended-Upgrade::Mail "";
