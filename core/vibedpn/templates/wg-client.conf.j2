# VibeDPN tunnel peer "{{ peer.name }}": a home box (role client) of this VPS.
# Install it on the box: sudo vibedpn init --role client --peer-config <this file>
# Keep it private — it holds the box's key.
[Interface]
PrivateKey = {{ peer.private_key }}
Address = {{ peer.address }}/32
{% if awg %}
Jc = {{ awg.jc }}
Jmin = {{ awg.jmin }}
Jmax = {{ awg.jmax }}
S1 = {{ awg.s1 }}
S2 = {{ awg.s2 }}
S3 = {{ awg.s3 }}
S4 = {{ awg.s4 }}
H1 = {{ awg.h1 }}
H2 = {{ awg.h2 }}
H3 = {{ awg.h3 }}
H4 = {{ awg.h4 }}
HeaderProtectionKey = {{ header_key }}
{% endif %}

[Peer]
PublicKey = {{ server_public_key }}
Endpoint = {{ endpoint }}
AllowedIPs = {{ allowed_ips }}
PersistentKeepalive = {{ keepalive }}
