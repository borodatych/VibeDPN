# VibeDPN — config.yaml
#
# Единственный источник правды о коробке. `vibedpn init` пишет этот файл сам; править руками
# можно, после правки — `vibedpn restart`. Секретов здесь нет: пароль UI, ключи WireGuard и
# keystore ноды лежат в secrets/ и data/, переменные Compose — в .env.
#
# Полная спека формата с образцами для всех ролей — docs/manuals/configSpec.md; какая роль что
# запускает — docs/roles.md.

version: {{ config.version }}

# Роль коробки: home | vps | client.
role: {{ config.role.value }}
{% if lan %}

# Сеть коробки. `init` определяет интерфейс, адрес и подсеть сам.
# mode: sidecar — коробка стоит в существующей LAN одним портом;
#       gateway — «в разрыв», WAN + LAN двумя портами (Stage 9), тогда нужен wan_interface.
# lan_address: адрес коробки в LAN, на нём слушают ui и dns — закрепите его на роутере.
network:
  mode: {{ config.network.mode.value }}
  lan_interface: {{ config.network.lan_interface }}
  lan_subnet: {{ config.network.lan_subnet }}
  lan_address: {{ config.network.lan_address }}
{% if config.network.wan_interface %}
  wan_interface: {{ config.network.wan_interface }}
{% endif %}

# Политика для трафика LAN.
# mode: off — всё напрямую; full — всё через default_upstream;
#       smart — через аплинк только smart_domains и устройства с политикой.
# default_upstream: vps | dpn — куда идёт трафик в full/smart; у роли home есть только dpn.
# failopen: false — упал аплинк, трафик стоит (kill-switch); true — уходит напрямую, осознанно.
# smart_domains: доменные суффиксы для режима smart, например [netflix.com, bbc.co.uk].
routing:
  mode: {{ config.routing.mode.value }}
  default_upstream: {{ config.routing.default_upstream.value }}
  failopen: {{ config.routing.failopen | tojson }}
  smart_domains: {{ config.routing.smart_domains | tojson }}

# Устройства LAN с собственной политикой поверх routing.mode: vps | dpn | bypass | block.
# Идентификация по MAC, IP — запасной вариант.
{% if config.devices %}
devices:
{% for device in config.devices %}
  - name: {{ device.name | tojson }}
{% if device.mac %}
    mac: {{ device.mac }}
{% endif %}
{% if device.ip %}
    ip: {{ device.ip }}
{% endif %}
    policy: {{ device.policy.value }}
{% endfor %}
{% else %}
devices: []
# devices:
#   - name: TV
#     mac: aa:bb:cc:dd:ee:01
#     policy: bypass
#   - name: Laptop
#     ip: 192.168.1.42
#     policy: dpn
{% endif %}

# Аплинки — куда коробка может отправлять трафик.
# vps: приватный WireGuard-туннель к своей VPS (только роль client; peer-файл — secrets/wg-client.conf).
# dpn: consumer Mysterium — выход через ноду сети; country — ISO 3166-1 alpha-2, без строки — любая.
upstreams:
  vps:
    enabled: {{ config.upstreams.vps.enabled | tojson }}
  dpn:
    enabled: {{ config.upstreams.dpn.enabled | tojson }}
{% if config.upstreams.dpn.country %}
    country: {{ config.upstreams.dpn.country }}
{% else %}
    # country: DE
{% endif %}
{% endif %}

# Нода Mysterium (provider): раздаём канал, получаем MYST.
# udp_ports: UDP-диапазон ноды, пробросить на роутере; traversal: порядок обхода NAT.
provider:
  enabled: {{ config.provider.enabled | tojson }}
  udp_ports: "{{ config.provider.udp_ports }}"
  traversal: [{{ config.provider.traversal | map(attribute="value") | join(", ") }}]
{% if config.wg_server %}

# Сервер приватного туннеля (роль vps): домашние коробки набирают endpoint:listen_port.
wg_server:
  endpoint: {{ config.wg_server.endpoint }}
  subnet: {{ config.wg_server.subnet }}
  listen_port: {{ config.wg_server.listen_port }}
{% endif %}
{% if not lan %}

# Файрвол VPS (nftables, таблица inet vibedpn, на вход всё закрыто, кроме перечисленного):
# ssh_ports — порты sshd (init читает их из sshd_config; убрать все — запереть себя),
# allow_tcp / allow_udp — другие сервисы владельца на этой же VPS.
firewall:
  enabled: {{ config.firewall.enabled | tojson }}
  ssh_ports: {{ config.firewall.ssh_ports | tojson }}
  allow_tcp: {{ config.firewall.allow_tcp | tojson }}
  allow_udp: {{ config.firewall.allow_udp | tojson }}
{% endif %}
{% if lan %}

# DNS и адблок: AdGuard Home на порту 53 LAN-адреса; upstreams — DNS-over-HTTPS.
dns:
  enabled: {{ config.dns.enabled | tojson }}
  upstreams:
{% for url in config.dns.upstreams %}
    - {{ url }}
{% endfor %}
  web_port: {{ config.dns.web_port }}

# Веб-интерфейс коробки, только на LAN-адресе.
ui:
  enabled: {{ config.ui.enabled | tojson }}
  port: {{ config.ui.port }}
  # Имя, по которому устройства открывают панель: AdGuard отвечает на него адресом коробки.
  host_name: {{ config.ui.host_name }}
  # full — N100 и мощнее; lite — Raspberry Pi: без фоновых задач и с маленьким Postgres (docs/uiVariants.md).
  variant: {{ config.ui.variant.value }}
{% endif %}

# API ядра: слушает только 127.0.0.1, на LAN его отдаёт панель ui под /api/core/ только после входа.
api:
  port: {{ config.api.port }}
