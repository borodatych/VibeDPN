# VibeDPN — config.yaml
#
# Единственный источник правды о коробке. `vibedpn init` пишет этот файл сам; править руками
# можно, после правки — `vibedpn up`. Секретов здесь нет: пароль UI, ключи WireGuard и
# keystore ноды лежат в secrets/ и data/, переменные Compose — в .env.
#
# Полная спека формата с образцами для всех ролей — docs/manuals/configSpec.md; какая роль что
# запускает — docs/roles.md.

version: {{ config.version }}

# Роль коробки: home | vps | client.
role: {{ config.role.value }}
{% if lan %}

# Сеть коробки. `init` определяет интерфейс, адрес и подсеть сам.
# mode: sidecar — коробка стоит в существующей LAN одним портом;
#       gateway — «в разрыв», WAN + LAN двумя портами (Stage 9), тогда нужен wan_interface.
# lan_address: адрес коробки в LAN, на нём слушают ui и dns — закрепите его на роутере.
network:
  mode: {{ config.network.mode.value }}
  lan_interface: {{ config.network.lan_interface }}
  lan_subnet: {{ config.network.lan_subnet }}
  lan_address: {{ config.network.lan_address }}
{% if config.network.wan_interface %}
  wan_interface: {{ config.network.wan_interface }}
{% endif %}
{% if config.network.mode.value != "gateway" %}
  # gateway — коробка «в разрыв» (docs/manuals/installation.md): WAN к провайдеру, LAN к устройствам,
  # сама раздаёт адреса; адрес lan_address на LAN-интерфейсе назначает система.
  # Проще всего — `sudo vibedpn init --force --lan-interface <имя>`; пароль Wi-Fi — secrets/wifi-passphrase.
  # mode: gateway
  # lan_interface: wlan0
  # lan_subnet: 192.168.50.0/24
  # lan_address: 192.168.50.1
  # wan_interface: enp1s0
  # dhcp:
  #   range_start: 192.168.50.100
  #   range_end: 192.168.50.249
  #   lease: 12h
  # wifi:
  #   ssid: "Home"
  #   country: DE
  #   band: "2.4"
  #   channel: 6
  #   security: wpa2-wpa3
{% endif %}
{% if config.network.mode.value == "gateway" %}
{% set pool = config.network.dhcp_pool() %}
  # DHCP коробки в LAN (dnsmasq): кого раздаёт и на сколько; адрес коробки в диапазон не входит.
  dhcp:
    range_start: {{ pool[0] }}
    range_end: {{ pool[1] }}
    lease: {{ (config.network.dhcp.lease if config.network.dhcp else "12h") }}
{% endif %}
{% if config.network.wifi %}
  # Точка доступа Wi-Fi на lan_interface. Пароль сети — secrets/wifi-passphrase (`sudo vibedpn wifi show`).
  # band: 2.4 | 5; channel — в пределах диапазона; security: wpa2-wpa3 (подключатся и старые устройства) | wpa3.
  wifi:
    ssid: {{ config.network.wifi.ssid | tojson }}
    country: {{ config.network.wifi.country }}
    band: "{{ config.network.wifi.band.value }}"
    channel: {{ config.network.wifi.channel }}
    security: {{ config.network.wifi.security.value }}
{% endif %}

# Политика для трафика LAN.
# mode: off — всё напрямую; full — всё через default_upstream;
#       smart — по правилам domains, остальное напрямую; устройства с политикой — как в full.
# default_upstream: vps | dpn | tor | wg-<имя> — куда идёт трафик в full; у роли home есть dpn
#   и собственные выходы по файлу WireGuard из upstreams.wg (имя берётся оттуда).
# failopen: false — упал аплинк, трафик стоит (kill-switch); true — уходит напрямую, осознанно.
# domains: правила режима smart. Домен покрывает поддомены; via: vps | dpn | tor | direct;
#   country — страна выхода для dpn; learn — CDN, которые сайт вызывает, идут за ним сами;
#   also — CDN, закреплённые за сайтом вручную.
# lists: готовые списки сайтов по URL — у каждого домена списка канал списка (via, country);
#   ядро скачивает список, хранит копию и обновляет раз в сутки; правило domains сильнее списка.
# networks: сети адресов (a.b.c.d/nn) для приложений, которые ходят по адресу, а не по имени —
#   Telegram; канал тот же (via, country, uplink), сеть direct сильнее сети через выход.
routing:
  mode: {{ config.routing.mode.value }}
  default_upstream: {{ config.routing.default_upstream }}
  failopen: {{ config.routing.failopen | tojson }}
{% if config.routing.domains %}
  domains:
{% for rule in config.routing.domains %}
    - domain: {{ rule.domain }}
      via: {{ rule.via.value }}
{% if rule.country %}
      country: {{ rule.country }}
{% endif %}
{% if rule.uplink %}
      uplink: {{ rule.uplink }}
{% endif %}
{% if not rule.learn %}
      learn: false
{% endif %}
{% if rule.also %}
      also: {{ rule.also | tojson }}
{% endif %}
{% endfor %}
{% else %}
  domains: []
  # domains:
  #   - domain: kinopoisk.ru
  #     via: dpn
  #     country: DE
  #   - domain: bank.example
  #     via: direct
{% endif %}
{% if config.routing.lists %}
  lists:
{% for item in config.routing.lists %}
    - url: {{ item.url | tojson }}
      via: {{ item.via.value }}
{% if item.country %}
      country: {{ item.country }}
{% endif %}
{% if item.uplink %}
      uplink: {{ item.uplink }}
{% endif %}
{% endfor %}
{% else %}
  lists: []
  # lists:
  #   - url: https://example.org/blocked-in-my-country.txt
  #     via: vps
{% endif %}
{% if config.routing.networks %}
  networks:
{% for item in config.routing.networks %}
    - network: {{ item.network }}
      via: {{ item.via.value }}
{% if item.country %}
      country: {{ item.country }}
{% endif %}
{% if item.uplink %}
      uplink: {{ item.uplink }}
{% endif %}
{% endfor %}
{% else %}
  networks: []
  # networks:
  #   - network: 149.154.160.0/20
  #     via: tor
{% endif %}

# Устройства LAN с собственной политикой поверх routing.mode: vps | dpn | tor | bypass | block.
# Идентификация по MAC, IP — запасной вариант.
{% if config.devices %}
devices:
{% for device in config.devices %}
  - name: {{ device.name | tojson }}
{% if device.mac %}
    mac: {{ device.mac }}
{% endif %}
{% if device.ip %}
    ip: {{ device.ip }}
{% endif %}
    policy: {{ device.policy.value }}
{% endfor %}
{% else %}
devices: []
# devices:
#   - name: TV
#     mac: aa:bb:cc:dd:ee:01
#     policy: bypass
#   - name: Laptop
#     ip: 192.168.1.42
#     policy: dpn
{% endif %}

# Аплинки — куда коробка может отправлять трафик.
# vps: приватный WireGuard-туннель к своей VPS (только роль client; peer-файл — secrets/wg-client.conf).
# dpn: consumer Mysterium — выход через ноду сети; country — ISO 3166-1 alpha-2, без строки — любая.
# wg: свои выходы по готовому файлу WireGuard (бесплатный тариф, платный поставщик, вторая коробка);
#   имя становится файлом secrets/wg-<имя>.conf, контейнером wg-<имя> и ключом маршрутизации.
upstreams:
  vps:
    enabled: {{ config.upstreams.vps.enabled | tojson }}
    # Пускать ли устройства LAN к панели ноды и API ядра VPS через туннель (по умолчанию закрыто).
    lan_access: {{ config.upstreams.vps.lan_access | tojson }}
  dpn:
    enabled: {{ config.upstreams.dpn.enabled | tojson }}
{% if config.upstreams.dpn.country %}
    country: {{ config.upstreams.dpn.country }}
{% else %}
    # country: DE
{% endif %}
{% if config.upstreams.wg %}
  wg:
{% for name, uplink in config.upstreams.wg.items() | sort %}
    {{ name }}:
      enabled: {{ uplink.enabled | tojson }}
{% endfor %}
{% else %}
  # Свои выходы по готовому файлу WireGuard: имя -> настройки, файл в secrets/wg-<имя>.conf.
  # Подключается командой `vibedpn uplink add <имя> <файл.conf>` (docs/manuals/wgUplink.md).
  # wg:
  #   proton:
  #     enabled: true
{% endif %}
  # Бесплатный выход через Tor по мостам Snowflake: без регистрации и оплаты, только TCP.
  # Включается командой `vibedpn tor enable` (docs/manuals/torUplink.md). Список мостов по умолчанию —
  # встроенные мосты Snowflake из Tor Browser; свои строки мостов — в bridges.
  tor:
    enabled: {{ config.upstreams.tor.enabled | tojson }}
{% if config.upstreams.tor.has_custom_bridges() %}
    bridges:
{% for line in config.upstreams.tor.bridges %}
      - {{ line | tojson }}
{% endfor %}
{% endif %}
{% endif %}

# Нода Mysterium (provider): раздаём канал, получаем MYST.
# udp_ports: UDP-диапазон ноды, пробросить на роутере; traversal: порядок обхода NAT.
provider:
  enabled: {{ config.provider.enabled | tojson }}
  udp_ports: "{{ config.provider.udp_ports }}"
  traversal: [{{ config.provider.traversal | map(attribute="value") | join(", ") }}]
{% if config.wg_server %}

# Сервер приватного туннеля (роль vps): домашние коробки набирают endpoint:listen_port.
wg_server:
  endpoint: {{ config.wg_server.endpoint }}
  subnet: {{ config.wg_server.subnet }}
  listen_port: {{ config.wg_server.listen_port }}
{% endif %}
{% if not lan %}

# Файрвол VPS (nftables, таблица inet vibedpn, на вход всё закрыто, кроме перечисленного):
# ssh_ports — порты sshd (init читает их из sshd_config; убрать все — запереть себя),
# allow_tcp / allow_udp — другие сервисы владельца на этой же VPS.
firewall:
  enabled: {{ config.firewall.enabled | tojson }}
  ssh_ports: {{ config.firewall.ssh_ports | tojson }}
  allow_tcp: {{ config.firewall.allow_tcp | tojson }}
  allow_udp: {{ config.firewall.allow_udp | tojson }}
{% endif %}
{% if lan %}

# DNS и адблок: AdGuard Home на порту 53 LAN-адреса; upstreams — DNS-over-HTTPS.
dns:
  enabled: {{ config.dns.enabled | tojson }}
  upstreams:
{% for url in config.dns.upstreams %}
    - {{ url }}
{% endfor %}
  web_port: {{ config.dns.web_port }}

# Веб-интерфейс коробки, только на LAN-адресе.
ui:
  enabled: {{ config.ui.enabled | tojson }}
  port: {{ config.ui.port }}
  # Имя, по которому устройства открывают панель: AdGuard отвечает на него адресом коробки.
  host_name: {{ config.ui.host_name }}
  # full — N100 и мощнее; lite — Raspberry Pi: без фоновых задач и с маленьким Postgres (docs/uiVariants.md).
  variant: {{ config.ui.variant.value }}
  # Язык панели по умолчанию: ru, en или код своего файла data/ui/locales/<код>.json; браузер может выбрать другой.
  language: {{ config.ui.language }}
{% endif %}

# API ядра: слушает только 127.0.0.1, на LAN его отдаёт панель ui под /api/core/ только после входа.
api:
  port: {{ config.api.port }}
