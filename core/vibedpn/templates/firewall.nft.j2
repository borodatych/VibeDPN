# VibeDPN host firewall, role vps. Rendered by core from config.yaml and applied as one
# transaction: `add table` + `delete table` + the whole table make a re-apply land on exactly
# this result (`flush table` would keep set elements, so a changed UDP range would pile up or
# clash). Docker's own tables and chains are untouched; published container ports are DNATed
# in prerouting and go through FORWARD, not through this input chain.
add table inet vibedpn
delete table inet vibedpn
table inet vibedpn {
{% if provider %}
  set myst_udp {
    type inet_service
    flags interval
    elements = { {{ udp_from }}-{{ udp_to }} }
  }
{% endif %}
  chain input {
    type filter hook input priority filter; policy drop;
    ct state established,related accept
    ct state invalid drop
    iif "lo" accept
    icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
    meta l4proto ipv6-icmp accept
    ip6 saddr fe80::/10 ip6 daddr fe80::/10 udp sport 547 udp dport 546 accept comment "dhcpv6 client"
    tcp dport { {{ ssh_ports | join(", ") }} } accept comment "ssh"
{% if wg_port %}
    udp dport {{ wg_port }} accept comment "wireguard server"
{% endif %}
{% if provider %}
    udp dport @myst_udp accept comment "mysterium node"
{% endif %}
    iifname "{{ wg_interface }}" accept comment "home boxes over the tunnel"
{% if allow_tcp %}
    tcp dport { {{ allow_tcp | join(", ") }} } accept comment "owner"
{% endif %}
{% if allow_udp %}
    udp dport { {{ allow_udp | join(", ") }} } accept comment "owner"
{% endif %}
  }
}
