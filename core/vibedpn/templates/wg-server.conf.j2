# VibeDPN WireGuard server, role vps. Rendered by core from config.yaml at every start;
# edits here are overwritten. The private key lives in server.key next to this file.
[Interface]
Address = {{ address }}
ListenPort = {{ listen_port }}
PrivateKey = {{ private_key }}
{% if awg %}
# AmneziaWG obfuscation: the same values, and the key, are in every peer file.
Jc = {{ awg.jc }}
Jmin = {{ awg.jmin }}
Jmax = {{ awg.jmax }}
S1 = {{ awg.s1 }}
S2 = {{ awg.s2 }}
S3 = {{ awg.s3 }}
S4 = {{ awg.s4 }}
H1 = {{ awg.h1 }}
H2 = {{ awg.h2 }}
H3 = {{ awg.h3 }}
H4 = {{ awg.h4 }}
HeaderProtectionKey = {{ header_key }}
{% endif %}
{% for peer in peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}/32
{% endfor %}
