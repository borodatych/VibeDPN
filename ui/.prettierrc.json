{
  "plugins": ["prettier-plugin-jsdoc"],
  "semi": false,
  "printWidth": 120,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "proseWrap": "always",
  "jsdocCapitalizeDescription": false,
  "jsdocKeepUnParseAbleExampleIndent": true,
  "jsdocCommentLineStrategy": "keep",
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "printWidth": 80
      }
    }
  ]
}
