{
  "name": "vibedpn-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "start0": {
    "version": "v0.1.23"
  },
  "scripts": {
    "dev": "point0 dev --hot",
    "generate": "point0 generate",
    "mcp:docs": "point0-docs-mcp",
    "build:code": "point0 build",
    "sentry:sourcemaps": "bun run ./src/modules/sentry/sourcemaps.ts",
    "build": "bun run build:code && bun run sentry:sourcemaps",
    "b": "bun run build",
    "start": "bun run ./dist/server/index.server.js",
    "prisma:reset": "cross-env NODE_ENV=development prisma migrate reset",
    "prisma:deploy": "cross-env NODE_ENV=development prisma migrate deploy",
    "prisma:generate": "cross-env NODE_ENV=development prisma generate",
    "prisma:migrate:dev": "cross-env NODE_ENV=development prisma migrate dev",
    "prisma:migrate:test": "cross-env NODE_ENV=test prisma migrate dev",
    "prisma:migrate": "bun run prisma:migrate:dev && bun run prisma:migrate:test && bun prisma:generate",
    "seed": "cross-env NODE_ENV=development bun --preload ./src/preload.ts ./src/modules/seed/bin.ts",
    "clean": "rimraf dist",
    "dev:test": "cross-env NODE_ENV=test bun dev",
    "test:unit": "cross-env NODE_ENV=test bun test --pass-with-no-tests --preload ./src/test/setup/unit.ts .unit.test.",
    "test:dom": "cross-env NODE_ENV=test bun test --pass-with-no-tests --preload ./src/test/setup/dom.ts .dom.test.",
    "test:int": "cross-env NODE_ENV=test bun test --pass-with-no-tests --preload ./src/test/setup/int.ts .int.test.",
    "test:e2e:no-run": "cross-env NODE_ENV=test E2E_TESTS_NO_RUN=true bun test --pass-with-no-tests --preload ./src/test/setup/e2e.ts .e2e.test.",
    "test:e2e:dev": "cross-env NODE_ENV=test E2E_TESTS_BUILD=false bun test --pass-with-no-tests --preload ./src/test/setup/e2e.ts .e2e.test.",
    "test:e2e:build": "cross-env NODE_ENV=test E2E_TESTS_BUILD=true bun test --pass-with-no-tests --preload ./src/test/setup/e2e.ts .e2e.test.",
    "test": "bun test:unit && bun test:dom && bun test:int && bun test:e2e:build",
    "tt": "bun run test",
    "types:6": "tsc --noEmit",
    "types": "./node_modules/typescript7/bin/tsc --noEmit",
    "lint:check": "eslint . --max-warnings 0 --cache --cache-location ./node_modules/.cache/eslint --cache-strategy content",
    "lint": "bun run lint:check --fix",
    "check": "bun run types && bun run lint:check",
    "format": "prettier --write .",
    "nice": "bun run format && bun run lint"
  },
  "dependencies": {
    "@1gr14/error0": "^0.4.8",
    "@1gr14/flat": "^0.1.4",
    "@1gr14/route0": "^0.3.0",
