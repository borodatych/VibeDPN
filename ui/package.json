    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prisma-json-types-generator": "^5.1.1",
    "rimraf": "^6.1.3",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
