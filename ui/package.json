    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.5.7",
    "@logtape/logtape": "^2.3.0",
    "@logtape/redaction": "^2.3.0",
    "@point0/basic-auth": "^0.3.10",
    "@point0/cache-control": "^0.3.10",
