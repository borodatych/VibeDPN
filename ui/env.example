# Local development of the box panel. On a box these come from compose.yaml and secrets/, not from a file.
HOST_ENV=local
PORT=3000
SERVER_PORT=3000
CLIENT_PORT=8000
SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:8000
DATABASE_URL=postgresql://vibedpn:vibedpn@localhost:5432/vibedpn?schema=public

LOG_LEVEL=info
LOG_MODE=pretty
LOG_FILTER=*,-prisma,-shutdown

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=__XXX__

# The box password: an htpasswd file with a bcrypt line for `admin`, as `vibedpn init` writes secrets/htpasswd.
HTPASSWD_FILE=./htpasswd.local
# The core API on 127.0.0.1 (VIBEDPN_API_PORT of the box).
CORE_API_PORT=4480
# The LAN address to listen on. Required in production; empty in development listens on every interface.
UI_LISTEN_HOST=

# Telemetry is off unless configured. A box sends nothing anywhere by default.
SOURCE_VERSION=
SENTRY_DSN_SERVER=
SENTRY_DSN_CLIENT=
SENTRY_AUTH_TOKEN=
MIXPANEL_PROJECT_TOKEN=
AXIOM_TOKEN=
AXIOM_EDGE=
