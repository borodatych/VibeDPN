# Live box state — never committed. Examples (config.example.yaml, .env.example) are.
/config.yaml
/config.yaml.bak
/.env
# Compose files vibedpn generates on the box at every `up`: the checkout is the box directory.
/compose.countries.yaml
/compose.wg.yaml
/secrets/
/data/
/backups/
# What a restore moves aside, and the lock of the tasks the host runs for the panel
/restore-backup-*/
/restore-failed-*/
/.host-task.lock

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
core/dist/

# Node
node_modules/
ui/dist/

# Local tooling
.claude/settings.local.json
# Real tokens of the seeded .vibe HTTP client (the seed's own .gitignore misses it).
.vibe/http-client.private.env.json
.DS_Store
.idea/

# OS image builds (images/os): the pi-gen checkout and the images themselves
images/os/pi-gen/work/
*.img
*.img.xz
